# These snippets provide basic LaTeX functionality to be used in all kinds of
# scenarios. Some of them are more specific than others. Some require packages
# (indicated in the description).

global !p

# Open the omni complete of vim. This is useful in places where Vimtex can
# provide a list of all available options.
def open_complete():
	vim.eval(r'feedkeys("\<C-x>\<C-o>", "n")')

# Return the name of the most inner environment.
def inner_env():
	return vim.eval("vimtex#env#get_inner()").get("name")

endglobal 

# --- Remove Redundant Spaces ---

# NOTE: ":" is not added here as it is used with a space before in math mode.
snippet "[\s~]([,\.;])" "Remove Redundant Spaces" riA
`!p snip.rv = match.group(1)`$0
endsnippet

# --- Environments, Sections ---

snippet beg "Environment" b
\begin{$1`!p open_complete()`}$2
${VISUAL}$0
\end{$1}
endsnippet

snippet code "Code Block (lstlisting)" b
\begin{lstlisting}[language=$1]
${VISUAL}$0
\end{lstlisting}
endsnippet

# TODO: Consider making these tab triggered for consistency.

snippet "#\s" "Section" rbA
\section{$1}$0
endsnippet

snippet "##\s" "Subsection" rbA
\subsection{$1}$0
endsnippet

snippet "###\s" "Subsubsection" rbA
\subsubsection{$1}$0
endsnippet

# --- Text decorations ---

snippet em "Wrap in emph" w
\emph{${VISUAL}$1}$0
endsnippet

snippet it "Wrap in textit" w
\textit{${VISUAL}$1}$0
endsnippet

snippet bf "Wrap in textbf" w
\textbf{${VISUAL}$1}$0
endsnippet

snippet say "Wrap in say (dirtytalk)" w
\say{${VISUAL}$1}$0
endsnippet

# --- References, Citations, Footnotes ---

snippet "\s?(c?ref)" "" rw
~\\`!p snip.rv = match.group(1)`{$1} $0`!p open_complete()`
endsnippet

snippet ci "Cite" w
\cite{$1`!p open_complete()`}$0
endsnippet

snippet cip "Cite Page" w
\cite[p.~$1]{$2`!p open_complete()`}$0
endsnippet

snippet "\sfm" "Footnotemark" rw
\footnotemark~$0
endsnippet

snippet ft "Footnotetext" w
\footnotetext{${1:${VISUAL}}}$0
endsnippet

# --- Definitions, Lemmas, Proofs, Remarks ---

snippet def "Definition" b
\begin{definition}[${1:Name}]
\label{def:`!p snip.rv = t[1].lower().replace(" ", "-")`}
$0
\end{definition}$0
endsnippet

snippet lem "Lemma" b
\begin{lemma}
$0
\end{lemma}$0
endsnippet

snippet pro "Proof" b
\begin{proof}
$0
\end{proof}$0
endsnippet

snippet rem "Remark" b
\begin{remark}
$0
\end{remark}$0
endsnippet

snippet lab "Label" "inner_env() in ['lemma', 'proof', 'remark']" be
\label{`!p snip.rv = inner_env()[:3]`:$1}
$0
endsnippet

# --- Lists ---

snippet enum "Dense Enumerated List" b
\begin{enumerate-dense}
	$0
\end{enumerate-dense}
endsnippet

snippet list "Dense Itemized List" b
\begin{itemize-dense}
	$0
\end{itemize-dense}
endsnippet

snippet i "Item" b
\item $0
endsnippet

snippet iit "Item With Italic Start" b
\item \textit{${VISUAL}$1:} $0
endsnippet

snippet ibf "Item With Bold Start" b
\item \textbf{${VISUAL}$1:} $0
endsnippet

# --- Tables ---

snippet table "Centered Table" b
\begin{centered-table}{ ${1:P{1em} | M} }
	$0
\end{centered-table}
endsnippet

snippet line "Horizontal Line in Table" b
\hline $0
endsnippet

