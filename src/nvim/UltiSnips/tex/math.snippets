# These snippets are for math mode.

global !p

# Returns true if inside a mathematical environment of any kind.
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'
		
endglobal

# --- Initiating Math  ---

snippet math "Math" b
\[
	$1
\]$0
endsnippet

snippet mm "Inline math" wA
$ $1$$2
endsnippet

# --- Non-math elements ---

context "math()"
snippet spc "Empty space" w
\quad $0
endsnippet

context "math()"
snippet tt "Text in math" w
\text{${VISUAL}$1}$0
endsnippet

context "math()"
snippet == "Align equals" wA
&=$0
endsnippet

# --- Fractions ---

context "math()"
snippet // "Fraction Raw" iA
\frac{$1}{$2}$0
endsnippet

context "math()"
snippet "((\d+)|(\d*)(\\)?([A-Za-z]+)((\^|_)(\{\d+\}|\d))*)/" "Fraction Adaptive" wrA
\frac{`!p snip.rv = match.group(1)`}{$1}$0
endsnippet

# --- Arrays and Tables ---

context "math()"
snippet arr "Array Environment" w
\begin{array}{${1:c}} ${VISUAL}${2} \end{array}$0
endsnippet

context "math()"
snippet vec "Vector" w
\left(\begin{array}{c} ${VISUAL}$1 \end{array}\right)$0
endsnippet

context "math()"
snippet mat "Matrix" w
\left(\begin{array}{${1:c}} ${VISUAL}$2 \end{array}\right)$0
endsnippet

context "math()"
snippet (. "Large left invisible brace" i
\left. $0
endsnippet

context "math()"
snippet ). "Large right invisible brace" i
\right. $0
endsnippet

context "math()"
snippet (( "Large left brace" i
\left( $0
endsnippet

context "math()"
snippet )) "Large right brace" i
\right) $0
endsnippet

context "math()"
snippet {{ "Large left curly brace" i
\left\\{ $0
endsnippet

context "math()"
snippet }} "Large right curly brace" i
\right\\} $0
endsnippet

# --- Postfixes ---

context "math()"
snippet "(\\?\w+)(,\.|\.,)" "Vector postfix" riA
\vec{`!p snip.rv=match.group(1)`}$0
endsnippet

priority -1
context "math()"
snippet "([A-Za-z])([\d])" "Auto subscript via number" wrA
`!p snip.rv = match.group(1) + "_" + match.group(2)`
endsnippet
priority 0

context "math()"
snippet "\s?sb" "Auto subscript via 'sb'" irA
_$0
endsnippet

context "math()"
snippet "\s?_([^\s,}{|\)]{2})" "Auto extend subscript" irA
_{`!p snip.rv = match.group(1)`$1}$0
endsnippet

context "math()"
snippet "\s?td" "Auto superscript" irA
^$0
endsnippet

context "math()"
snippet "\s?\^([^\s,}{|\)]{2})" "Auto extend superscript" irA
^{`!p snip.rv = match.group(1)`$1}$0
endsnippet

# --- Math Fonts ---

# Generate single letters in the specified math fonts.
# For mathbb and mathcal make the letter upper case.
context "math()"
snippet "m?a?t?h?(bb|bf|cal|frak|sf)\s?(\w)" "Math Fonts" rwA
\math`!p snip.rv = match.group(1)`{`!p
snip.rv = match.group(2)
if match.group(1) in ["bb", "cal"]:
	snip.rv = snip.rv.upper()
`}$0
endsnippet

# --- Sum, Product ---

context "math()"
snippet sum "Summation with subscript" w
\sum_{$1}$0
endsnippet

context "math()"
snippet sumto "Summation with sub- and superscript" w
\sum_{$1}^{$2}$0
endsnippet

context "math()"
snippet prod "Product with subscript" w
\prod_{$1}$0
endsnippet

context "math()"
snippet prodto "Product with sub- and superscript" w
\prod_{$1}^{$2}$0
endsnippet

# --- Miscellaneous ---

context "math()"
snippet set "Set" w
\\{$1\\}$0
endsnippet

# --- Symbols ---

context "math()"
snippet equ "Equivalent symbol" w
\equiv $0
endsnippet

context "math()"
snippet neq "Not equal symbol" w
\neq $0
endsnippet

context "math()"
snippet and "And symbol" w
\wedge $0
endsnippet

context "math()"
snippet or "Or symbol" w
\vee $0
endsnippet

context "math()"
snippet not "Not symbol" w
\neg $0
endsnippet

context "math()"
snippet imp "Implication arrow symbol" w
\Rightarrow $0
endsnippet

context "math()"
snippet iff "Bimplication arrow symbol" w
\Leftrightarrow $0
endsnippet

context "math()"
snippet larr "Left arrow symbol" w
\leftarrow $0
endsnippet

context "math()"
snippet rarr "Right arrow symbol" w
\rightarrow $0
endsnippet

context "math()"
snippet dt "Delta symbol" w
\Delta $0
endsnippet

context "math()"
snippet ld "Low dots symbol" w
\ldots $0
endsnippet

context "math()"
snippet cd "Center dots symbol" w
\cdots $0
endsnippet

context "math()"
snippet inf "Infinity symbol" w
\infty $0
endsnippet

context "math()"
snippet in "In symbol" w
\in $0
endsnippet

context "math()"
snippet to "To symbol" w
\to $0
endsnippet

context "math()"
snippet sm "Set minus symbol" w
\setminus $0
endsnippet

context "math()"
snippet bar "Bar with spaces around" w
\ | \ $0
endsnippet

context "math()"
snippet geq "Greater or equal to symbol" w
\geq $0
endsnippet

context "math()"
snippet leq "Less than or equal to symbol" w
\leq $0
endsnippet

context "math()"
snippet cup "Cup symbol" w
\cup $0
endsnippet

context "math()"
snippet cap "Cap symbol" w
\cap $0
endsnippet

context "math()"
snippet times "Times symbol" w
\times $0
endsnippet

context "math()"
snippet mul "Multiplication symbol" w
\cdot $0
endsnippet

context "math()"
snippet sse "Subset or equals symbol" w
\subseteq $0
endsnippet

context "math()"
snippet all "For all symbol" w
\forall $0
endsnippet

context "math()"
snippet ex "Exists symbol" w
\exists $0
endsnippet

